<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SmartGuard.Settings</RootNamespace>
    <AssemblyName>SmartGuard.Settings</AssemblyName>
    <ApplicationIcon>..\..\assets\branding\SmartGuard.ico</ApplicationIcon>
    <InstallerVersionFile>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '..\..\installer\version.txt'))</InstallerVersionFile>
    <Version>$([System.IO.File]::ReadAllText('$(InstallerVersionFile)').Trim())</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmartGuard.Configuration\SmartGuard.Configuration.csproj" />
    <ProjectReference Include="..\SmartGuard.Contracts\SmartGuard.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Page Include="SmartGuard.Settings.xaml" />
    <Page Include="Themes\Light.xaml" />
    <Page Include="Themes\Dark.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SmartGuard.Settings.Tests" />
    <InternalsVisibleTo Include="SmartGuard.Settings.LogView.Tests" />
  </ItemGroup>

</Project>
