# 自动处理换行符：提交时统一为 LF，checkout 时按以下规则处理
* text=auto

# Windows 批处理脚本保留 CRLF，确保在 Windows 环境下可正常执行
*.cmd text eol=crlf
*.bat text eol=crlf

# 代码与项目文件统一使用 LF
*.cs text eol=lf
*.csproj text eol=lf
*.slnx text eol=lf
*.props text eol=lf

# 配置文件统一使用 LF
*.json text eol=lf
*.xml text eol=lf
*.config text eol=lf

# 脚本与文档统一使用 LF；PowerShell 例外：
# Windows PowerShell 5.1 会把无 BOM 的 UTF-8 .ps1 按 ANSI/GBK 解码，
# 中文标点末字节（如 。 的 0x82）会吞掉裸 LF、把下一行语句并进注释，
# 因此 .ps1 必须以 CRLF 检出。
*.ps1 text eol=crlf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
