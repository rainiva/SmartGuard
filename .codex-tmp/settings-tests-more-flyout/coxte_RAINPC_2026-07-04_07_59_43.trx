                          Style="{StaticResource SecondaryButton}"
                          MinWidth="128"
                          Padding="12,8"
                          HorizontalContentAlignment="Left"/&gt;
                &lt;/StackPanel&gt;
              &lt;/Border&gt;
            &lt;/Canvas&gt;
          &lt;/Grid&gt;
        &lt;/Border&gt;
      &lt;/Grid&gt;

      &lt;!-- Settings are applied instantly; no bottom action bar is needed. --&gt;
    &lt;/Grid&gt;

