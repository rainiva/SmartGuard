                &lt;Button x:Name="btnLogScrollBottom" Content="&amp;#x5E95;&amp;#x90E8;" Style="{StaticResource LogToolbarCompactButton}"/&gt;
              &lt;/WrapPanel&gt;
            &lt;/Grid&gt;

            &lt;Canvas x:Name="logMoreFlyoutLayer"
