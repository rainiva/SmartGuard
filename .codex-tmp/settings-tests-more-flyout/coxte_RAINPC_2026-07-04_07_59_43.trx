                &lt;CheckBox x:Name="chkLogSearchCaseSensitive" Content="&amp;#x533A;&amp;#x5206;&amp;#x5927;&amp;#x5C0F;&amp;#x5199;" Style="{StaticResource SettingsFilterCheckBox}" Margin="0,0,0,6"/&gt;
              &lt;/WrapPanel&gt;

              &lt;StackPanel x:Name="panelLogCustomRange" Orientation="Horizontal" Margin="0,4,0,8" Visibility="Collapsed"&gt;
                &lt;TextBlock Text="&amp;#x8D77;" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/&gt;
                &lt;TextBox x:Name="txtLogRangeStart" Width="160" FontSize="12" Foreground="{DynamicResource TextPrimary}" ToolTip="yyyy-MM-dd HH:mm:ss"/&gt;
                &lt;TextBlock Text="&amp;#x6B62;" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="12,0,6,0"/&gt;
                &lt;TextBox x:Name="txtLogRangeEnd" Width="160" FontSize="12" Foreground="{DynamicResource TextPrimary}" ToolTip="yyyy-MM-dd HH:mm:ss"/&gt;
              &lt;/StackPanel&gt;

              &lt;TextBlock x:Name="lblLogStatus" Text="&amp;#x6682;&amp;#x65E0;&amp;#x65E5;&amp;#x5FD7;" FontSize="11" Foreground="{DynamicResource TextTertiary}" Margin="0,0,0,8"/&gt;
            &lt;/StackPanel&gt;

            &lt;!-- Scrollable Log Content --&gt;
            &lt;Border x:Name="logViewportBorder"
                    Grid.Row="1"
                    Background="{DynamicResource NumberBoxBackground}"
