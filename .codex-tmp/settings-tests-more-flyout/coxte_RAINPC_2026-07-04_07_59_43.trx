    <UnitTestResult executionId="11c79b5b-db4a-47fd-b7ea-723ba96988e5" testId="fbf77acd-d85a-459a-fd03-411be813f22d" testName="SmartGuard.Settings.Tests.LogToolbarLayoutTests.Log_page_uses_reader_style_header_instead_of_heavy_toolbar_card" computerName="RAINPC" duration="00:00:00.0934308" startTime="2026-07-04T07:59:43.4022665+08:00" endTime="2026-07-04T07:59:43.4022670+08:00" testType="13cdc9d9-ddb5-4fa4-a97d-d965ccfc6d4b" outcome="Failed" testListId="8c84fa94-04c1-424b-9868-57a2d4851a1d" relativeResultsDirectory="11c79b5b-db4a-47fd-b7ea-723ba96988e5">
      <Output>
        <ErrorInfo>
          <Message>Expected xaml to match regex "x:Name="logSearchFilterHost"[\s\S]{0,500}x:Name="btnLogRefresh"[\s\S]{0,240}x:Name="btnLogMore"[\s\S]{0,500}x:Name="logMoreFlyout"" because search should share the top action row with refresh and overflow actions, but "&lt;Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SmartGuard.Settings"
        Title="智能电源守护设置"
        Height="640" Width="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        MinHeight="500" MinWidth="600"
        Background="{DynamicResource WindowBackground}"
        FontFamily="Microsoft YaHei UI, Segoe UI Variable, Segoe UI"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        x:Name="RootWindow"&gt;
  &lt;Window.Resources&gt;
    &lt;ResourceDictionary&gt;
      &lt;!-- Theme Colors (Light default) --&gt;
      &lt;SolidColorBrush x:Key="WindowBackground" Color="#F3F3F3"/&gt;
      &lt;SolidColorBrush x:Key="WindowForeground" Color="#1A1A1A"/&gt;
      &lt;SolidColorBrush x:Key="NavigationBackground" Color="#F9F9F9"/&gt;
      &lt;SolidColorBrush x:Key="NavigationItemForeground" Color="#1A1A1A"/&gt;
      &lt;SolidColorBrush x:Key="NavigationItemSelectedBackground" Color="#E5E5E5"/&gt;
      &lt;SolidColorBrush x:Key="NavigationItemSelectedForeground" Color="#005FB8"/&gt;
      &lt;SolidColorBrush x:Key="NavigationItemHoverBackground" Color="#EEEEEE"/&gt;
      &lt;SolidColorBrush x:Key="NavigationBorderBrush" Color="#E0E0E0"/&gt;
      &lt;SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/&gt;
      &lt;SolidColorBrush x:Key="CardBorderBrush" Color="#E5E5E5"/&gt;
      &lt;Color x:Key="CardShadowColor"&gt;#20000000&lt;/Color&gt;
      &lt;SolidColorBrush x:Key="TextPrimary" Color="#1A1A1A"/&gt;
      &lt;SolidColorBrush x:Key="TextSecondary" Color="#616161"/&gt;
      &lt;SolidColorBrush x:Key="TextTertiary" Color="#8A8A8A"/&gt;
      &lt;SolidColorBrush x:Key="TextAccent" Color="#005FB8"/&gt;
      &lt;SolidColorBrush x:Key="PrimaryButtonBackground" Color="#005FB8"/&gt;
      &lt;SolidColorBrush x:Key="PrimaryButtonForeground" Color="#FFFFFF"/&gt;
      &lt;SolidColorBrush x:Key="PrimaryButtonHoverBackground" Color="#004578"/&gt;
      &lt;SolidColorBrush x:Key="SecondaryButtonBackground" Color="#FFFFFF"/&gt;
      &lt;SolidColorBrush x:Key="SecondaryButtonForeground" Color="#1A1A1A"/&gt;
      &lt;SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="#D1D1D1"/&gt;
      &lt;SolidColorBrush x:Key="SecondaryButtonHoverBackground" Color="#F0F0F0"/&gt;
      &lt;SolidColorBrush x:Key="ToggleTrackOff" Color="#C4C4C4"/&gt;
      &lt;SolidColorBrush x:Key="ToggleTrackOn" Color="#005FB8"/&gt;
      &lt;SolidColorBrush x:Key="ToggleThumb" Color="#FFFFFF"/&gt;
      &lt;SolidColorBrush x:Key="NumberBoxBackground" Color="#FFFFFF"/&gt;
      &lt;SolidColorBrush x:Key="NumberBoxBorderBrush" Color="#D1D1D1"/&gt;
      &lt;SolidColorBrush x:Key="NumberBoxButtonBackground" Color="#F0F0F0"/&gt;
      &lt;SolidColorBrush x:Key="NumberBoxButtonHoverBackground" Color="#E5E5E5"/&gt;
      &lt;SolidColorBrush x:Key="InfoBarBackground" Color="#E8F3FF"/&gt;
      &lt;SolidColorBrush x:Key="InfoBarForeground" Color="#005FB8"/&gt;
      &lt;SolidColorBrush x:Key="InfoBarBorderBrush" Color="#B3D7F7"/&gt;
      &lt;SolidColorBrush x:Key="DividerBrush" Color="#E5E5E5"/&gt;
      &lt;Thickness x:Key="SettingsContentPageMargin"&gt;24,24,24,12&lt;/Thickness&gt;
      &lt;Thickness x:Key="ToastContainerMargin"&gt;0,24,24,0&lt;/Thickness&gt;

      &lt;!-- Navigation Item Style --&gt;
      &lt;Style x:Key="NavigationItemStyle" TargetType="ListBoxItem"&gt;
        &lt;Setter Property="Height" Value="40"/&gt;
        &lt;Setter Property="Padding" Value="16,0"/&gt;
        &lt;Setter Property="Background" Value="Transparent"/&gt;
        &lt;Setter Property="Foreground" Value="{DynamicResource NavigationItemForeground}"/&gt;
        &lt;Setter Property="Template"&gt;
          &lt;Setter.Value&gt;
            &lt;ControlTemplate TargetType="ListBoxItem"&gt;
              &lt;Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Margin="0"&gt;
                &lt;ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" Margin="{TemplateBinding Padding}"/&gt;
              &lt;/Border&gt;
              &lt;ControlTemplate.Triggers&gt;
                &lt;Trigger Property="IsSelected" Value="True"&gt;
                  &lt;Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavigationItemSelectedBackground}"/&gt;
                  &lt;Setter Property="Foreground" Value="{DynamicResource NavigationItemSelectedForeground}"/&gt;
                  &lt;Setter Property="FontWeight" Value="SemiBold"/&gt;
                &lt;/Trigger&gt;
                &lt;Trigger Property="IsMouseOver" Value="True"&gt;
                  &lt;Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavigationItemHoverBackground}"/&gt;
                &lt;/Trigger&gt;
              &lt;/ControlTemplate.Triggers&gt;
            &lt;/ControlTemplate&gt;
          &lt;/Setter.Value&gt;
        &lt;/Setter&gt;
      &lt;/Style&gt;

      &lt;!-- Settings Card Style --&gt;
      &lt;Style x:Key="SettingsCard" TargetType="Border"&gt;
        &lt;Setter Property="Background" Value="{DynamicResource CardBackground}"/&gt;
        &lt;Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/&gt;
        &lt;Setter Property="BorderThickness" Value="1"/&gt;
        &lt;Setter Property="CornerRadius" Value="8"/&gt;
        &lt;Setter Property="Padding" Value="20,16"/&gt;
        &lt;Setter Property="Margin" Value="0,0,0,12"/&gt;
      &lt;/Style&gt;

      &lt;!-- Section Title --&gt;
      &lt;Style x:Key="SectionTitle" TargetType="TextBlock"&gt;
        &lt;Setter Property="FontSize" Value="18"/&gt;
        &lt;Setter Property="FontWeight" Value="SemiBold"/&gt;
        &lt;Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/&gt;
        &lt;Setter Property="Margin" Value="0,0,0,16"/&gt;
      &lt;/Style&gt;

      &lt;!-- Card group title (within settings cards) --&gt;
      &lt;Style x:Key="SettingsGroupTitle" TargetType="TextBlock"&gt;
        &lt;Setter Property="FontSize" Value="14"/&gt;
        &lt;Setter Property="FontWeight" Value="SemiBold"/&gt;
        &lt;Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/&gt;
        &lt;Setter Property="Margin" Value="0,0,0,4"/&gt;
        &lt;Setter Property="TextOptions.TextFormattingMode" Value="Display"/&gt;
        &lt;Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/&gt;
      &lt;/Style&gt;

      &lt;!-- Card group description --&gt;
      &lt;Style x:Key="SettingsCardDescription" TargetType="TextBlock"&gt;
        &lt;Setter Property="FontSize" Value="12"/&gt;
        &lt;Setter Property="LineHeight" Value="20"/&gt;
        &lt;Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/&gt;
        &lt;Setter Property="Margin" Value="0,0,0,12"/&gt;
        &lt;Setter Property="TextWrapping" Value="Wrap"/&gt;
        &lt;Setter Property="TextOptions.TextFormattingMode" Value="Display"/&gt;
        &lt;Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/&gt;
      &lt;/Style&gt;

      &lt;!-- Setting item primary label --&gt;
      &lt;Style x:Key="SettingsItemTitle" TargetType="TextBlock"&gt;
        &lt;Setter Property="FontSize" Value="13"/&gt;
        &lt;Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/&gt;
        &lt;Setter Property="TextOptions.TextFormattingMode" Value="Display"/&gt;
        &lt;Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/&gt;
      &lt;/Style&gt;

      &lt;!-- Setting item hint text below label --&gt;
      &lt;Style x:Key="SettingsItemHint" TargetType="TextBlock"&gt;
        &lt;Setter Property="FontSize" Value="12"/&gt;
        &lt;Setter Property="LineHeight" Value="18"/&gt;
        &lt;Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/&gt;
        &lt;Setter Property="Margin" Value="0,2,0,0"/&gt;
        &lt;Setter Property="TextWrapping" Value="Wrap"/&gt;
        &lt;Setter Property="TextOptions.TextFormattingMode" Value="Display"/&gt;
        &lt;Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/&gt;
      &lt;/Style&gt;

      &lt;!-- Settings Item Row --&gt;
      &lt;Style x:Key="SettingsItemRow" TargetType="Border"&gt;
        &lt;Setter Property="Background" Value="Transparent"/&gt;
        &lt;Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/&gt;
        &lt;Setter Property="BorderThickness" Value="0,0,0,1"/&gt;
        &lt;Setter Property="Padding" Value="0,14"/&gt;
        &lt;Setter Property="Margin" Value="0"/&gt;
      &lt;/Style&gt;

      &lt;!-- Toggle Switch (CheckBox Template) --&gt;
      &lt;Style x:Key="ToggleSwitch" TargetType="CheckBox"&gt;
        &lt;Setter Property="OverridesDefaultStyle" Value="True"/&gt;
        &lt;Setter Property="FocusVisualStyle" Value="{x:Null}"/&gt;
        &lt;Setter Property="Template"&gt;
          &lt;Setter.Value&gt;
            &lt;ControlTemplate TargetType="CheckBox"&gt;
              &lt;Grid VerticalAlignment="Center" HorizontalAlignment="Right"&gt;
                &lt;Grid Width="44" Height="24"&gt;
                  &lt;Border x:Name="Track" CornerRadius="12" Background="{DynamicResource ToggleTrackOff}"/&gt;
                  &lt;Border x:Name="Thumb" Width="20" Height="20" CornerRadius="10" Background="{DynamicResource ToggleThumb}"
                          HorizontalAlignment="Left" Margin="2,0,0,0"/&gt;
                &lt;/Grid&gt;
              &lt;/Grid&gt;
              &lt;ControlTemplate.Triggers&gt;
                &lt;Trigger Property="IsChecked" Value="True"&gt;
                  &lt;Setter TargetName="Track" Property="Background" Value="{DynamicResource ToggleTrackOn}"/&gt;
                  &lt;Trigger.EnterActions&gt;
                    &lt;BeginStoryboard&gt;
                      &lt;Storyboard&gt;
                        &lt;ThicknessAnimation Storyboard.TargetName="Thumb"
                                            Storyboard.TargetProperty="Margin"
                                            To="22,0,0,0"
                                            Duration="0:0:0.32"&gt;
                          &lt;ThicknessAnimation.EasingFunction&gt;
                            &lt;CubicEase EasingMode="EaseOut"/&gt;
                          &lt;/ThicknessAnimation.EasingFunction&gt;
                        &lt;/ThicknessAnimation&gt;
                      &lt;/Storyboard&gt;
                    &lt;/BeginStoryboard&gt;
                  &lt;/Trigger.EnterActions&gt;
                  &lt;Trigger.ExitActions&gt;
                    &lt;BeginStoryboard&gt;
                      &lt;Storyboard&gt;
                        &lt;ThicknessAnimation Storyboard.TargetName="Thumb"
                                            Storyboard.TargetProperty="Margin"
                                            To="2,0,0,0"
                                            Duration="0:0:0.32"&gt;
                          &lt;ThicknessAnimation.EasingFunction&gt;
                            &lt;CubicEase EasingMode="EaseOut"/&gt;
                          &lt;/ThicknessAnimation.EasingFunction&gt;
                        &lt;/ThicknessAnimation&gt;
                      &lt;/Storyboard&gt;
                    &lt;/BeginStoryboard&gt;
                  &lt;/Trigger.ExitActions&gt;
                &lt;/Trigger&gt;
                &lt;Trigger Property="IsEnabled" Value="False"&gt;
                  &lt;Setter TargetName="Track" Property="Opacity" Value="0.5"/&gt;
                &lt;/Trigger&gt;
              &lt;/ControlTemplate.Triggers&gt;
            &lt;/ControlTemplate&gt;
          &lt;/Setter.Value&gt;
        &lt;/Setter&gt;
        &lt;Setter Property="Cursor" Value="Hand"/&gt;
        &lt;Setter Property="VerticalAlignment" Value="Center"/&gt;
        &lt;Setter Property="HorizontalAlignment" Value="Right"/&gt;
      &lt;/Style&gt;

      &lt;!-- Primary Button --&gt;
      &lt;Style x:Key="PrimaryButton" TargetType="Button"&gt;
        &lt;Setter Property="Background" Value="{DynamicResource PrimaryButtonBackground}"/&gt;
        &lt;Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForeground}"/&gt;
        &lt;Setter Property="FontWeight" Value="SemiBold"/&gt;
        &lt;Setter Property="Padding" Value="20,10"/&gt;
        &lt;Setter Property="MinWidth" Value="96"/&gt;
        &lt;Setter Property="BorderThickness" Value="0"/&gt;
        &lt;Setter Property="Cursor" Value="Hand"/&gt;
        &lt;Setter Property="Template"&gt;
          &lt;Setter.Value&gt;
            &lt;ControlTemplate TargetType="Button"&gt;
              &lt;Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"&gt;
                &lt;ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/&gt;
              &lt;/Border&gt;
              &lt;ControlTemplate.Triggers&gt;
                &lt;Trigger Property="IsMouseOver" Value="True"&gt;
                  &lt;Setter TargetName="bd" Property="Background" Value="{DynamicResource PrimaryButtonHoverBackground}"/&gt;
                &lt;/Trigger&gt;
                &lt;Trigger Property="IsPressed" Value="True"&gt;
                  &lt;Setter TargetName="bd" Property="RenderTransform"&gt;
                    &lt;Setter.Value&gt;
                      &lt;ScaleTransform ScaleX="0.98" ScaleY="0.98"/&gt;
                    &lt;/Setter.Value&gt;
                  &lt;/Setter&gt;
                &lt;/Trigger&gt;
              &lt;/ControlTemplate.Triggers&gt;
            &lt;/ControlTemplate&gt;
          &lt;/Setter.Value&gt;
        &lt;/Setter&gt;
      &lt;/Style&gt;

      &lt;!-- Secondary Button --&gt;
      &lt;Style x:Key="SecondaryButton" TargetType="Button"&gt;
        &lt;Setter Property="Background" Value="{DynamicResource SecondaryButtonBackground}"/&gt;
        &lt;Setter Property="Foreground" Value="{DynamicResource SecondaryButtonForeground}"/&gt;
        &lt;Setter Property="Padding" Value="20,10"/&gt;
        &lt;Setter Property="MinWidth" Value="96"/&gt;
        &lt;Setter Property="BorderBrush" Value="{DynamicResource SecondaryButtonBorderBrush}"/&gt;
        &lt;Setter Property="BorderThickness" Value="1"/&gt;
        &lt;Setter Property="Cursor" Value="Hand"/&gt;
        &lt;Setter Property="Template"&gt;
          &lt;Setter.Value&gt;
            &lt;ControlTemplate TargetType="Button"&gt;
              &lt;Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"&gt;
                &lt;ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/&gt;
              &lt;/Border&gt;
              &lt;ControlTemplate.Triggers&gt;
                &lt;Trigger Property="IsMouseOver" Value="True"&gt;
                  &lt;Setter TargetName="bd" Property="Background" Value="{DynamicResource SecondaryButtonHoverBackground}"/&gt;
                &lt;/Trigger&gt;
                &lt;Trigger Property="IsPressed" Value="True"&gt;
                  &lt;Setter TargetName="bd" Property="RenderTransform"&gt;
                    &lt;Setter.Value&gt;
                      &lt;ScaleTransform ScaleX="0.98" ScaleY="0.98"/&gt;
                    &lt;/Setter.Value&gt;
                  &lt;/Setter&gt;
                &lt;/Trigger&gt;
              &lt;/ControlTemplate.Triggers&gt;
            &lt;/ControlTemplate&gt;
          &lt;/Setter.Value&gt;
        &lt;/Setter&gt;
      &lt;/Style&gt;

      &lt;!-- Compact toolbar button (log page) --&gt;
      &lt;Style x:Key="LogToolbarCompactButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}"&gt;
        &lt;Setter Property="Padding" Value="10,6"/&gt;
        &lt;Setter Property="MinWidth" Value="0"/&gt;
        &lt;Setter Property="FontSize" Value="12"/&gt;
      &lt;/Style&gt;

      &lt;!-- NumberBox increment/decrement button (must be defined before NumberBox template) --&gt;
      &lt;Style x:Key="NumberBoxButton" TargetType="Button"&gt;
        &lt;Setter Property="Background" Value="{DynamicResource NumberBoxButtonBackground}"/&gt;
        &lt;Setter Property="BorderThickness" Value="0"/&gt;
        &lt;Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/&gt;
        &lt;Setter Property="Cursor" Value="Hand"/&gt;
        &lt;Setter Property="FocusVisualStyle" Value="{x:Null}"/&gt;
        &lt;Setter Property="Template"&gt;
          &lt;Setter.Value&gt;
            &lt;ControlTemplate TargetType="Button"&gt;
              &lt;Border x:Name="Bd" Background="{TemplateBinding Background}" BorderThickness="0"&gt;
                &lt;ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/&gt;
              &lt;/Border&gt;
              &lt;ControlTemplate.Triggers&gt;
                &lt;Trigger Property="IsMouseOver" Value="True"&gt;
                  &lt;Setter TargetName="Bd" Property="Background" Value="{DynamicResource NumberBoxButtonHoverBackground}"/&gt;
                &lt;/Trigger&gt;
                &lt;Trigger Property="IsPressed" Value="True"&gt;
                  &lt;Setter TargetName="Bd" Property="Opacity" Value="0.85"/&gt;
                &lt;/Trigger&gt;
              &lt;/ControlTemplate.Triggers&gt;
            &lt;/ControlTemplate&gt;
          &lt;/Setter.Value&gt;
        &lt;/Setter&gt;
      &lt;/Style&gt;

      &lt;!-- NumberBox Style --&gt;
      &lt;Style TargetType="local:NumberBox"&gt;
        &lt;Setter Property="Width" Value="120"/&gt;
        &lt;Setter Property="Height" Value="32"/&gt;
        &lt;Setter Property="VerticalAlignment" Value="Center"/&gt;
        &lt;Setter Property="Template"&gt;
          &lt;Setter.Value&gt;
            &lt;ControlTemplate TargetType="local:NumberBox"&gt;
              &lt;Border Background="{DynamicResource NumberBoxBackground}" BorderBrush="{DynamicResource NumberBoxBorderBrush}" BorderThickness="1" CornerRadius="4"&gt;
                &lt;Grid&gt;
                  &lt;Grid.ColumnDefinitions&gt;
                    &lt;ColumnDefinition Width="*"/&gt;
                    &lt;ColumnDefinition Width="28"/&gt;
                    &lt;ColumnDefinition Width="28"/&gt;
                  &lt;/Grid.ColumnDefinitions&gt;
                  &lt;TextBox x:Name="PART_TextBox" Grid.Column="0" BorderThickness="0" Background="Transparent"
                           Foreground="{DynamicResource TextPrimary}" CaretBrush="{DynamicResource TextPrimary}"
                           Text="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                           VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                           Padding="4,0"/&gt;
                  &lt;Button Grid.Column="1" Content="-" Command="{TemplateBinding DecrementCommand}"
                          Style="{StaticResource NumberBoxButton}" FontSize="14" FontWeight="Bold"/&gt;
                  &lt;Button Grid.Column="2" Content="+" Command="{TemplateBinding IncrementCommand}"
                          Style="{StaticResource NumberBoxButton}" FontSize="14" FontWeight="Bold"/&gt;
                &lt;/Grid&gt;
              &lt;/Border&gt;
            &lt;/ControlTemplate&gt;
          &lt;/Setter.Value&gt;
        &lt;/Setter&gt;
      &lt;/Style&gt;

      &lt;!-- Fluent TextBox --&gt;
      &lt;Style x:Key="SettingsTextBox" TargetType="TextBox"&gt;
        &lt;Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/&gt;
        &lt;Setter Property="Background" Value="{DynamicResource NumberBoxBackground}"/&gt;
        &lt;Setter Property="BorderBrush" Value="{DynamicResource NumberBoxBorderBrush}"/&gt;
        &lt;Setter Property="BorderThickness" Value="1"/&gt;
        &lt;Setter Property="Padding" Value="8,6"/&gt;
        &lt;Setter Property="MinHeight" Value="32"/&gt;
        &lt;Setter Property="VerticalContentAlignment" Value="Center"/&gt;
        &lt;Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/&gt;
        &lt;Setter Property="SelectionBrush" Value="{DynamicResource TextAccent}"/&gt;
        &lt;Setter Property="OverridesDefaultStyle" Value="True"/&gt;
        &lt;Setter Property="FocusVisualStyle" Value="{x:Null}"/&gt;
        &lt;Setter Property="Template"&gt;
          &lt;Setter.Value&gt;
            &lt;ControlTemplate TargetType="TextBox"&gt;
              &lt;Border x:Name="Bd"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="4"&gt;
                &lt;ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/&gt;
              &lt;/Border&gt;
              &lt;ControlTemplate.Triggers&gt;
                &lt;Trigger Property="IsKeyboardFocused" Value="True"&gt;
                  &lt;Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TextAccent}"/&gt;
                &lt;/Trigger&gt;
                &lt;Trigger Property="IsEnabled" Value="False"&gt;
                  &lt;Setter TargetName="Bd" Property="Opacity" Value="0.6"/&gt;
                &lt;/Trigger&gt;
              &lt;/ControlTemplate.Triggers&gt;
            &lt;/ControlTemplate&gt;
          &lt;/Setter.Value&gt;
        &lt;/Setter&gt;
      &lt;/Style&gt;

      &lt;Style x:Key="SettingsTextBoxBorderless" TargetType="TextBox" BasedOn="{StaticResource SettingsTextBox}"&gt;
        &lt;Setter Property="BorderThickness" Value="0"/&gt;
        &lt;Setter Property="Background" Value="Transparent"/&gt;
        &lt;Setter Property="MinHeight" Value="0"/&gt;
        &lt;Setter Property="Padding" Value="0"/&gt;
      &lt;/Style&gt;

      &lt;!-- Fluent Hyperlink --&gt;
      &lt;Style TargetType="Hyperlink"&gt;
        &lt;Setter Property="Foreground" Value="{DynamicResource TextAccent}"/&gt;
        &lt;Setter Property="TextDecorations" Value="None"/&gt;
        &lt;Style.Triggers&gt;
          &lt;Trigger Property="IsMouseOver" Value="True"&gt;
            &lt;Setter Property="TextDecorations" Value="Underline"/&gt;
          &lt;/Trigger&gt;
        &lt;/Style.Triggers&gt;
      &lt;/Style&gt;

      &lt;!-- Fluent ScrollBar --&gt;
      &lt;Style x:Key="SettingsScrollBar" TargetType="ScrollBar"&gt;
        &lt;Setter Property="OverridesDefaultStyle" Value="True"/&gt;
        &lt;Setter Property="Width" Value="8"/&gt;
        &lt;Setter Property="MinWidth" Value="8"/&gt;
        &lt;Setter Property="Template"&gt;
          &lt;Setter.Value&gt;
            &lt;ControlTemplate TargetType="ScrollBar"&gt;
              &lt;Grid Background="Transparent"&gt;
                &lt;Track x:Name="PART_Track"&gt;
                  &lt;Track.Style&gt;
                    &lt;Style TargetType="Track"&gt;
                      &lt;Setter Property="IsDirectionReversed" Value="False"/&gt;
                      &lt;Style.Triggers&gt;
                        &lt;DataTrigger Binding="{Binding Orientation, RelativeSource={RelativeSource TemplatedParent}}" Value="Vertical"&gt;
                          &lt;Setter Property="IsDirectionReversed" Value="True"/&gt;
                        &lt;/DataTrigger&gt;
                      &lt;/Style.Triggers&gt;
                    &lt;/Style&gt;
                  &lt;/Track.Style&gt;
                  &lt;Track.Thumb&gt;
                    &lt;Thumb&gt;
                      &lt;Thumb.Template&gt;
                        &lt;ControlTemplate TargetType="Thumb"&gt;
                          &lt;Border Background="{DynamicResource TextTertiary}" CornerRadius="4" Opacity="0.55"/&gt;
                        &lt;/ControlTemplate&gt;
                      &lt;/Thumb.Template&gt;
                    &lt;/Thumb&gt;
                  &lt;/Track.Thumb&gt;
                &lt;/Track&gt;
              &lt;/Grid&gt;
            &lt;/ControlTemplate&gt;
          &lt;/Setter.Value&gt;
        &lt;/Setter&gt;
        &lt;Style.Triggers&gt;
          &lt;Trigger Property="Orientation" Value="Horizontal"&gt;
            &lt;Setter Property="Width" Value="Auto"/&gt;
            &lt;Setter Property="Height" Value="8"/&gt;
            &lt;Setter Property="MinHeight" Value="8"/&gt;
          &lt;/Trigger&gt;
        &lt;/Style.Triggers&gt;
      &lt;/Style&gt;

      &lt;Style x:Key="SettingsScrollViewer" TargetType="ScrollViewer"&gt;
        &lt;Setter Property="VerticalScrollBarVisibility" Value="Auto"/&gt;
        &lt;Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/&gt;
        &lt;Setter Property="Template"&gt;
          &lt;Setter.Value&gt;
            &lt;ControlTemplate TargetType="ScrollViewer"&gt;
              &lt;Grid&gt;
                &lt;Grid.ColumnDefinitions&gt;
                  &lt;ColumnDefinition Width="*"/&gt;
                  &lt;ColumnDefinition Width="Auto"/&gt;
                &lt;/Grid.ColumnDefinitions&gt;
                &lt;Grid.RowDefinitions&gt;
                  &lt;RowDefinition Height="*"/&gt;
                  &lt;RowDefinition Height="Auto"/&gt;
                &lt;/Grid.RowDefinitions&gt;
                &lt;ScrollContentPresenter Grid.Row="0" Grid.Column="0" Margin="{TemplateBinding Padding}"/&gt;
                &lt;ScrollBar x:Name="PART_VerticalScrollBar"
                           Grid.Row="0"
                           Grid.Column="1"
                           Style="{StaticResource SettingsScrollBar}"
                           Value="{TemplateBinding VerticalOffset}"
                           Maximum="{TemplateBinding ScrollableHeight}"
                           ViewportSize="{TemplateBinding ViewportHeight}"
                           Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                           HorizontalAlignment="Right"/&gt;
                &lt;ScrollBar x:Name="PART_HorizontalScrollBar"
                           Grid.Row="1"
                           Grid.Column="0"
                           Style="{StaticResource SettingsScrollBar}"
                           Orientation="Horizontal"
                           Value="{TemplateBinding HorizontalOffset}"
                           Maximum="{TemplateBinding ScrollableWidth}"
                           ViewportSize="{TemplateBinding ViewportWidth}"
                           Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                           VerticalAlignment="Bottom"/&gt;
              &lt;/Grid&gt;
            &lt;/ControlTemplate&gt;
          &lt;/Setter.Value&gt;
        &lt;/Setter&gt;
      &lt;/Style&gt;

      &lt;Style x:Key="SettingsLogListBox" TargetType="ListBox"&gt;
        &lt;Setter Property="ScrollViewer.CanContentScroll" Value="True"/&gt;
        &lt;Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/&gt;
        &lt;Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/&gt;
        &lt;Setter Property="Template"&gt;
          &lt;Setter.Value&gt;
            &lt;ControlTemplate TargetType="ListBox"&gt;
              &lt;Border Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"&gt;
                &lt;ScrollViewer Style="{StaticResource SettingsScrollViewer}"
                              Focusable="False"
                              CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                              HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                              VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                              Padding="{TemplateBinding Padding}"&gt;
                  &lt;ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/&gt;
                &lt;/ScrollViewer&gt;
              &lt;/Border&gt;
            &lt;/ControlTemplate&gt;
          &lt;/Setter.Value&gt;
        &lt;/Setter&gt;
      &lt;/Style&gt;

      &lt;!-- Settings ComboBox --&gt;
      &lt;Style x:Key="SettingsComboBoxItem" TargetType="ComboBoxItem"&gt;
        &lt;Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/&gt;
        &lt;Setter Property="Background" Value="{DynamicResource NumberBoxBackground}"/&gt;
        &lt;Setter Property="Padding" Value="8,6"/&gt;
        &lt;Setter Property="HorizontalContentAlignment" Value="Stretch"/&gt;
        &lt;Setter Property="OverridesDefaultStyle" Value="True"/&gt;
        &lt;Setter Property="FocusVisualStyle" Value="{x:Null}"/&gt;
        &lt;Setter Property="Template"&gt;
          &lt;Setter.Value&gt;
            &lt;ControlTemplate TargetType="ComboBoxItem"&gt;
              &lt;Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"&gt;
                &lt;ContentPresenter/&gt;
              &lt;/Border&gt;
              &lt;ControlTemplate.Triggers&gt;
                &lt;Trigger Property="IsHighlighted" Value="True"&gt;
                  &lt;Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavigationItemHoverBackground}"/&gt;
                &lt;/Trigger&gt;
                &lt;Trigger Property="IsSelected" Value="True"&gt;
                  &lt;Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavigationItemSelectedBackground}"/&gt;
                &lt;/Trigger&gt;
              &lt;/ControlTemplate.Triggers&gt;
            &lt;/ControlTemplate&gt;
          &lt;/Setter.Value&gt;
        &lt;/Setter&gt;
      &lt;/Style&gt;

      &lt;Style x:Key="SettingsComboBox" TargetType="ComboBox"&gt;
        &lt;Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/&gt;
        &lt;Setter Property="Background" Value="Transparent"/&gt;
        &lt;Setter Property="BorderBrush" Value="Transparent"/&gt;
        &lt;Setter Property="BorderThickness" Value="0"/&gt;
        &lt;Setter Property="Height" Value="32"/&gt;
        &lt;Setter Property="OverridesDefaultStyle" Value="True"/&gt;
        &lt;Setter Property="FocusVisualStyle" Value="{x:Null}"/&gt;
        &lt;Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/&gt;
        &lt;Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/&gt;
        &lt;Setter Property="ItemContainerStyle" Value="{StaticResource SettingsComboBoxItem}"/&gt;
        &lt;Setter Property="Template"&gt;
          &lt;Setter.Value&gt;
            &lt;ControlTemplate TargetType="ComboBox"&gt;
              &lt;Grid SnapsToDevicePixels="True"&gt;
                &lt;ToggleButton x:Name="ToggleButton"
                              Focusable="False"
                              Background="Transparent"
                              BorderThickness="0"
                              OverridesDefaultStyle="True"
                              FocusVisualStyle="{x:Null}"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                              ClickMode="Press"&gt;
                  &lt;ToggleButton.Template&gt;
                    &lt;ControlTemplate TargetType="ToggleButton"&gt;
                      &lt;Border x:Name="Bd"
                              Background="{DynamicResource NumberBoxBackground}"
                              BorderBrush="{DynamicResource NumberBoxBorderBrush}"
                              BorderThickness="1"
                              CornerRadius="4"&gt;
                        &lt;Grid&gt;
                          &lt;Grid.ColumnDefinitions&gt;
                            &lt;ColumnDefinition Width="*"/&gt;
                            &lt;ColumnDefinition Width="24"/&gt;
                          &lt;/Grid.ColumnDefinitions&gt;
                          &lt;ContentPresenter Grid.Column="0" Margin="8,0,4,0" VerticalAlignment="Center" HorizontalAlignment="Left"/&gt;
                          &lt;TextBlock Grid.Column="1" Text="▾" Foreground="{DynamicResource TextSecondary}" FontSize="12"
                                     VerticalAlignment="Center" HorizontalAlignment="Center"/&gt;
                        &lt;/Grid&gt;
                      &lt;/Border&gt;
                      &lt;ControlTemplate.Triggers&gt;
                        &lt;Trigger Property="IsMouseOver" Value="True"&gt;
                          &lt;Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TextAccent}"/&gt;
                        &lt;/Trigger&gt;
                        &lt;Trigger Property="IsChecked" Value="True"&gt;
                          &lt;Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TextAccent}"/&gt;
                        &lt;/Trigger&gt;
                      &lt;/ControlTemplate.Triggers&gt;
                    &lt;/ControlTemplate&gt;
                  &lt;/ToggleButton.Template&gt;
                &lt;/ToggleButton&gt;
                &lt;ContentPresenter x:Name="ContentSite"
                                  IsHitTestVisible="False"
                                  Content="{TemplateBinding SelectionBoxItem}"
                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                  Margin="8,0,28,0"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Left"/&gt;
                &lt;Popup x:Name="Popup"
                       Placement="Bottom"
                       IsOpen="{TemplateBinding IsDropDownOpen}"
                       AllowsTransparency="True"
                       Focusable="False"
                       PopupAnimation="Slide"&gt;
                  &lt;Border Background="{DynamicResource NumberBoxBackground}"
                          BorderBrush="{DynamicResource NumberBoxBorderBrush}"
                          BorderThickness="1"
                          CornerRadius="4"
                          MinWidth="{TemplateBinding ActualWidth}"
                          MaxHeight="240"&gt;
                    &lt;ScrollViewer SnapsToDevicePixels="True"&gt;
                      &lt;StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/&gt;
                    &lt;/ScrollViewer&gt;
                  &lt;/Border&gt;
                &lt;/Popup&gt;
              &lt;/Grid&gt;
            &lt;/ControlTemplate&gt;
          &lt;/Setter.Value&gt;
        &lt;/Setter&gt;
      &lt;/Style&gt;

      &lt;!-- Filter checkbox (log page and inline options) --&gt;
      &lt;Style x:Key="SettingsFilterCheckBox" TargetType="CheckBox"&gt;
        &lt;Setter Property="OverridesDefaultStyle" Value="True"/&gt;
        &lt;Setter Property="FocusVisualStyle" Value="{x:Null}"/&gt;
        &lt;Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/&gt;
        &lt;Setter Property="VerticalAlignment" Value="Center"/&gt;
        &lt;Setter Property="Cursor" Value="Hand"/&gt;
        &lt;Setter Property="Template"&gt;
          &lt;Setter.Value&gt;
            &lt;ControlTemplate TargetType="CheckBox"&gt;
              &lt;StackPanel Orientation="Horizontal"&gt;
                &lt;Border x:Name="Box" Width="16" Height="16" CornerRadius="3"
                        BorderBrush="{DynamicResource NumberBoxBorderBrush}" BorderThickness="1"
                        Background="{DynamicResource NumberBoxBackground}" Margin="0,0,6,0"&gt;
                  &lt;TextBlock x:Name="CheckMark" Text="✓" FontSize="11" FontWeight="Bold"
                             Foreground="{DynamicResource TextAccent}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/&gt;
                &lt;/Border&gt;
                &lt;ContentPresenter VerticalAlignment="Center"/&gt;
              &lt;/StackPanel&gt;
              &lt;ControlTemplate.Triggers&gt;
                &lt;Trigger Property="IsChecked" Value="True"&gt;
                  &lt;Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/&gt;
                  &lt;Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource TextAccent}"/&gt;
                &lt;/Trigger&gt;
                &lt;Trigger Property="IsMouseOver" Value="True"&gt;
                  &lt;Setter TargetName="Box" Property="Background" Value="{DynamicResource NumberBoxButtonHoverBackground}"/&gt;
                &lt;/Trigger&gt;
              &lt;/ControlTemplate.Triggers&gt;
            &lt;/ControlTemplate&gt;
          &lt;/Setter.Value&gt;
        &lt;/Setter&gt;
      &lt;/Style&gt;

      &lt;!-- InfoBar Style --&gt;
      &lt;Style x:Key="InfoBar" TargetType="Border"&gt;
        &lt;Setter Property="Background" Value="{DynamicResource InfoBarBackground}"/&gt;
        &lt;Setter Property="BorderBrush" Value="{DynamicResource InfoBarBorderBrush}"/&gt;
        &lt;Setter Property="BorderThickness" Value="1"/&gt;
        &lt;Setter Property="CornerRadius" Value="4"/&gt;
        &lt;Setter Property="Padding" Value="12,8"/&gt;
        &lt;Setter Property="Margin" Value="0,0,0,12"/&gt;
        &lt;Setter Property="Visibility" Value="Collapsed"/&gt;
      &lt;/Style&gt;

      &lt;!-- Default Fluent styles for common controls (explicit styles remain on toggles/buttons) --&gt;
      &lt;Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource SettingsTextBox}"/&gt;
      &lt;Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource SettingsComboBox}"/&gt;

    &lt;/ResourceDictionary&gt;
  &lt;/Window.Resources&gt;

  &lt;Grid&gt;
    &lt;Grid.ColumnDefinitions&gt;
      &lt;ColumnDefinition Width="220"/&gt;
      &lt;ColumnDefinition Width="*"/&gt;
    &lt;/Grid.ColumnDefinitions&gt;

    &lt;!-- Left Navigation Panel --&gt;
    &lt;Border Grid.Column="0" Background="{DynamicResource NavigationBackground}" BorderBrush="{DynamicResource NavigationBorderBrush}" BorderThickness="0,0,1,0"&gt;
      &lt;Grid&gt;
        &lt;!-- Navigation Items --&gt;
        &lt;ListBox x:Name="navList" BorderThickness="0" Background="Transparent"
                 FocusVisualStyle="{x:Null}"
                 ItemContainerStyle="{StaticResource NavigationItemStyle}" Margin="8,16,8,0"&gt;
          &lt;ListBoxItem x:Name="navGeneral" IsSelected="True"&gt;
            &lt;StackPanel Orientation="Horizontal"&gt;
              &lt;TextBlock Text="&amp;#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/&gt;
              &lt;TextBlock Text="常规" VerticalAlignment="Center"/&gt;
            &lt;/StackPanel&gt;
          &lt;/ListBoxItem&gt;
          &lt;ListBoxItem x:Name="navAdvanced"&gt;
            &lt;StackPanel Orientation="Horizontal"&gt;
              &lt;TextBlock Text="&amp;#xE9A6;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/&gt;
              &lt;TextBlock Text="高级" VerticalAlignment="Center"/&gt;
            &lt;/StackPanel&gt;
          &lt;/ListBoxItem&gt;
          &lt;ListBoxItem x:Name="navNotifications"&gt;
            &lt;StackPanel Orientation="Horizontal"&gt;
              &lt;TextBlock Text="&amp;#xEA8F;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/&gt;
              &lt;TextBlock Text="通知" VerticalAlignment="Center"/&gt;
            &lt;/StackPanel&gt;
          &lt;/ListBoxItem&gt;
          &lt;ListBoxItem x:Name="navLogs"&gt;
            &lt;StackPanel Orientation="Horizontal"&gt;
              &lt;TextBlock Text="&amp;#xE7C3;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/&gt;
              &lt;TextBlock Text="日志" VerticalAlignment="Center"/&gt;
            &lt;/StackPanel&gt;
          &lt;/ListBoxItem&gt;
          &lt;ListBoxItem x:Name="navDisplay"&gt;
            &lt;StackPanel Orientation="Horizontal"&gt;
              &lt;TextBlock Text="&amp;#xE793;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/&gt;
              &lt;TextBlock Text="显示" VerticalAlignment="Center"/&gt;
            &lt;/StackPanel&gt;
          &lt;/ListBoxItem&gt;
          &lt;ListBoxItem x:Name="navAbout"&gt;
            &lt;StackPanel Orientation="Horizontal"&gt;
              &lt;TextBlock Text="&amp;#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/&gt;
              &lt;TextBlock Text="关于" VerticalAlignment="Center"/&gt;
            &lt;/StackPanel&gt;
          &lt;/ListBoxItem&gt;
        &lt;/ListBox&gt;
      &lt;/Grid&gt;
    &lt;/Border&gt;

    &lt;!-- Right Content Area --&gt;
    &lt;Grid x:Name="rightContentRoot" Grid.Column="1" Background="{DynamicResource WindowBackground}" Margin="{StaticResource SettingsContentPageMargin}"&gt;
      &lt;Grid.RowDefinitions&gt;
        &lt;RowDefinition Height="Auto"/&gt;
        &lt;RowDefinition Height="*"/&gt;
      &lt;/Grid.RowDefinitions&gt;

      &lt;TextBlock x:Name="txtPageTitle" Grid.Row="0" Text="常规设置" Style="{StaticResource SectionTitle}"/&gt;

      &lt;!-- Content Pages --&gt;
      &lt;ScrollViewer x:Name="contentScrollViewer" Grid.Row="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Style="{StaticResource SettingsScrollViewer}" HorizontalContentAlignment="Stretch"&gt;
        &lt;StackPanel HorizontalAlignment="Stretch"&gt;

          &lt;!-- General Page --&gt;
          &lt;StackPanel x:Name="pageGeneral" HorizontalAlignment="Stretch"&gt;

            &lt;!-- System Card --&gt;
            &lt;Border Style="{StaticResource SettingsCard}"&gt;
              &lt;StackPanel&gt;
                &lt;TextBlock Text="系统" Style="{StaticResource SettingsGroupTitle}"/&gt;
                &lt;TextBlock Text="管理开机启动和基本系统行为" Style="{StaticResource SettingsCardDescription}"/&gt;

                &lt;Border Style="{StaticResource SettingsItemRow}" BorderThickness="0"&gt;
                  &lt;Grid&gt;
                    &lt;Grid.ColumnDefinitions&gt;
                      &lt;ColumnDefinition Width="*"/&gt;
                      &lt;ColumnDefinition Width="Auto"/&gt;
                    &lt;/Grid.ColumnDefinitions&gt;
                    &lt;StackPanel Grid.Column="0"&gt;
                      &lt;TextBlock Text="开机自启动" Style="{StaticResource SettingsItemTitle}"/&gt;
                      &lt;TextBlock Text="启动 Core 和托盘程序" Style="{StaticResource SettingsItemHint}"/&gt;
                    &lt;/StackPanel&gt;
                    &lt;CheckBox x:Name="tglAutoStart" Grid.Column="1" Style="{StaticResource ToggleSwitch}"/&gt;
                  &lt;/Grid&gt;
                &lt;/Border&gt;
              &lt;/StackPanel&gt;
            &lt;/Border&gt;

            &lt;!-- Idle &amp; Battery Card --&gt;
            &lt;Border Style="{StaticResource SettingsCard}"&gt;
              &lt;StackPanel&gt;
                &lt;TextBlock Text="空闲与电池" Style="{StaticResource SettingsGroupTitle}"/&gt;
                &lt;TextBlock Text="自动切换电源计划的空闲时间和电池阈值" Style="{StaticResource SettingsCardDescription}"/&gt;

                &lt;Border Style="{StaticResource SettingsItemRow}"&gt;
                  &lt;Grid&gt;
                    &lt;Grid.ColumnDefinitions&gt;
                      &lt;ColumnDefinition Width="*"/&gt;
                      &lt;ColumnDefinition Width="Auto"/&gt;
                    &lt;/Grid.ColumnDefinitions&gt;
                    &lt;StackPanel Grid.Column="0"&gt;
                      &lt;TextBlock Text="空闲后切换平衡" Style="{StaticResource SettingsItemTitle}"/&gt;
                      &lt;TextBlock Text="空闲多久后切换到平衡计划（分钟）" Style="{StaticResource SettingsItemHint}"/&gt;
                    &lt;/StackPanel&gt;
                    &lt;StackPanel Grid.Column="1" Orientation="Horizontal"&gt;
                      &lt;TextBlock x:Name="lblBalanced" Text="5 分钟" Foreground="{DynamicResource TextAccent}" FontWeight="SemiBold"
                                 VerticalAlignment="Center" Margin="0,0,12,0"/&gt;
                      &lt;local:NumberBox x:Name="sldBalanced" Minimum="1" Maximum="120" SmallChange="1"/&gt;
                    &lt;/StackPanel&gt;
                  &lt;/Grid&gt;
                &lt;/Border&gt;

                &lt;Border Style="{StaticResource SettingsItemRow}"&gt;
                  &lt;Grid&gt;
                    &lt;Grid.ColumnDefinitions&gt;
                      &lt;ColumnDefinition Width="*"/&gt;
                      &lt;ColumnDefinition Width="Auto"/&gt;
                    &lt;/Grid.ColumnDefinitions&gt;
                    &lt;StackPanel Grid.Column="0"&gt;
                      &lt;TextBlock Text="空闲后切换节能" Style="{StaticResource SettingsItemTitle}"/&gt;
                      &lt;TextBlock Text="空闲多久后切换到节能计划（分钟）" Style="{StaticResource SettingsItemHint}"/&gt;
                    &lt;/StackPanel&gt;
                    &lt;StackPanel Grid.Column="1" Orientation="Horizontal"&gt;
                      &lt;TextBlock x:Name="lblSaver" Text="15 分钟" Foreground="{DynamicResource TextAccent}" FontWeight="SemiBold"
                                 VerticalAlignment="Center" Margin="0,0,12,0"/&gt;
                      &lt;local:NumberBox x:Name="sldSaver" Minimum="2" Maximum="240" SmallChange="1"/&gt;
                    &lt;/StackPanel&gt;
                  &lt;/Grid&gt;
                &lt;/Border&gt;

                &lt;Border Style="{StaticResource SettingsItemRow}" BorderThickness="0"&gt;
                  &lt;Grid&gt;
                    &lt;Grid.ColumnDefinitions&gt;
                      &lt;ColumnDefinition Width="*"/&gt;
                      &lt;ColumnDefinition Width="Auto"/&gt;
                    &lt;/Grid.ColumnDefinitions&gt;
                    &lt;StackPanel Grid.Column="0"&gt;
                      &lt;TextBlock Text="低电量阈值" Style="{StaticResource SettingsItemTitle}"/&gt;
                      &lt;TextBlock Text="低于此百分比时触发保护（%）" Style="{StaticResource SettingsItemHint}"/&gt;
                    &lt;/StackPanel&gt;
                    &lt;StackPanel Grid.Column="1" Orientation="Horizontal"&gt;
                      &lt;TextBlock x:Name="lblBattery" Text="30%" Foreground="{DynamicResource TextAccent}" FontWeight="SemiBold"
                                 VerticalAlignment="Center" Margin="0,0,12,0"/&gt;
                      &lt;local:NumberBox x:Name="sldBattery" Minimum="0" Maximum="100" SmallChange="5"/&gt;
                    &lt;/StackPanel&gt;
                  &lt;/Grid&gt;
                &lt;/Border&gt;
              &lt;/StackPanel&gt;
            &lt;/Border&gt;
          &lt;/StackPanel&gt;

          &lt;!-- Advanced Page --&gt;
          &lt;StackPanel x:Name="pageAdvanced" Visibility="Collapsed" HorizontalAlignment="Stretch"&gt;

            &lt;Border Style="{StaticResource SettingsCard}"&gt;
              &lt;StackPanel&gt;
                &lt;TextBlock Text="运行参数" Style="{StaticResource SettingsGroupTitle}"/&gt;
                &lt;TextBlock Text="调整引擎轮询频率、心跳日志和亮度恢复延迟" Style="{StaticResource SettingsCardDescription}"/&gt;

                &lt;Border Style="{StaticResource SettingsItemRow}"&gt;
                  &lt;Grid&gt;
                    &lt;Grid.ColumnDefinitions&gt;
                      &lt;ColumnDefinition Width="*"/&gt;
                      &lt;ColumnDefinition Width="Auto"/&gt;
                    &lt;/Grid.ColumnDefinitions&gt;
                    &lt;StackPanel Grid.Column="0"&gt;
                      &lt;TextBlock Text="轮询间隔" Style="{StaticResource SettingsItemTitle}"/&gt;
                      &lt;TextBlock Text="引擎检查系统状态的频率（秒）" Style="{StaticResource SettingsItemHint}"/&gt;
                    &lt;/StackPanel&gt;
                    &lt;StackPanel Grid.Column="1" Orientation="Horizontal"&gt;
                      &lt;TextBlock x:Name="lblPoll" Text="15 秒" Foreground="{DynamicResource TextAccent}" FontWeight="SemiBold"
                                 VerticalAlignment="Center" Margin="0,0,12,0"/&gt;
                      &lt;local:NumberBox x:Name="sldPoll" Minimum="5" Maximum="120" SmallChange="5"/&gt;
                    &lt;/StackPanel&gt;
                  &lt;/Grid&gt;
                &lt;/Border&gt;

                &lt;Border Style="{StaticResource SettingsItemRow}"&gt;
                  &lt;Grid&gt;
                    &lt;Grid.ColumnDefinitions&gt;
                      &lt;ColumnDefinition Width="*"/&gt;
                      &lt;ColumnDefinition Width="Auto"/&gt;
                    &lt;/Grid.ColumnDefinitions&gt;
                    &lt;StackPanel Grid.Column="0" Margin="0,0,16,0"&gt;
                      &lt;TextBlock Text="心跳日志间隔" Style="{StaticResource SettingsItemTitle}"/&gt;
                      &lt;TextBlock Text="无事件时，每隔多久写入一条 HEART 状态日志" Style="{StaticResource SettingsItemHint}"/&gt;
                      &lt;TextBlock Text="（分钟；0 表示关闭）" Style="{StaticResource SettingsItemHint}"/&gt;
                    &lt;/StackPanel&gt;
                    &lt;StackPanel Grid.Column="1" Orientation="Horizontal"&gt;
                      &lt;TextBlock x:Name="lblHeartbeat" Text="10 分钟" Foreground="{DynamicResource TextAccent}" FontWeight="SemiBold"
                                 VerticalAlignment="Center" Margin="0,0,12,0"/&gt;
                      &lt;local:NumberBox x:Name="sldHeartbeat" Minimum="0" Maximum="1440" SmallChange="1"/&gt;
                    &lt;/StackPanel&gt;
                  &lt;/Grid&gt;
                &lt;/Border&gt;

                &lt;Border Style="{StaticResource SettingsItemRow}" BorderThickness="0"&gt;
                  &lt;Grid&gt;
                    &lt;Grid.ColumnDefinitions&gt;
                      &lt;ColumnDefinition Width="*"/&gt;
                      &lt;ColumnDefinition Width="Auto"/&gt;
                    &lt;/Grid.ColumnDefinitions&gt;
                    &lt;StackPanel Grid.Column="0"&gt;
                      &lt;TextBlock Text="亮度恢复延迟" Style="{StaticResource SettingsItemTitle}"/&gt;
                      &lt;TextBlock Text="从节能恢复后延迟恢复亮度（毫秒）" Style="{StaticResource SettingsItemHint}"/&gt;
                    &lt;/StackPanel&gt;
                    &lt;StackPanel Grid.Column="1" Orientation="Horizontal"&gt;
                      &lt;TextBlock x:Name="lblBrightMs" Text="500 毫秒" Foreground="{DynamicResource TextAccent}" FontWeight="SemiBold"
                                 VerticalAlignment="Center" Margin="0,0,12,0"/&gt;
                      &lt;local:NumberBox x:Name="sldBrightMs" Minimum="0" Maximum="3000" SmallChange="50"/&gt;
                    &lt;/StackPanel&gt;
                  &lt;/Grid&gt;
                &lt;/Border&gt;
              &lt;/StackPanel&gt;
            &lt;/Border&gt;

            &lt;Border Style="{StaticResource SettingsCard}"&gt;
              &lt;StackPanel&gt;
                &lt;TextBlock Text="电源计划映射" Style="{StaticResource SettingsGroupTitle}"/&gt;
                &lt;TextBlock Text="选择 SmartGuard 三档策略分别对应的 Windows 电源计划" Style="{StaticResource SettingsCardDescription}"/&gt;

                &lt;Border Style="{StaticResource SettingsItemRow}"&gt;
                  &lt;Grid&gt;
                    &lt;Grid.ColumnDefinitions&gt;
                      &lt;ColumnDefinition Width="*"/&gt;
                      &lt;ColumnDefinition Width="Auto"/&gt;
                    &lt;/Grid.ColumnDefinitions&gt;
                    &lt;StackPanel Grid.Column="0"&gt;
                      &lt;TextBlock Text="高性能" Style="{StaticResource SettingsItemTitle}"/&gt;
                      &lt;TextBlock Text="活跃状态下使用的电源计划" Style="{StaticResource SettingsItemHint}"/&gt;
                    &lt;/StackPanel&gt;
                    &lt;ComboBox x:Name="cmbActivePlan" Grid.Column="1" Width="240" MinWidth="180" Style="{StaticResource SettingsComboBox}"/&gt;
                  &lt;/Grid&gt;
                &lt;/Border&gt;

                &lt;Border Style="{StaticResource SettingsItemRow}"&gt;
                  &lt;Grid&gt;
                    &lt;Grid.ColumnDefinitions&gt;
                      &lt;ColumnDefinition Width="*"/&gt;
                      &lt;ColumnDefinition Width="Auto"/&gt;
                    &lt;/Grid.ColumnDefinitions&gt;
                    &lt;StackPanel Grid.Column="0"&gt;
                      &lt;TextBlock Text="平衡" Style="{StaticResource SettingsItemTitle}"/&gt;
                      &lt;TextBlock Text="空闲一段时间后切换到的电源计划" Style="{StaticResource SettingsItemHint}"/&gt;
                    &lt;/StackPanel&gt;
                    &lt;ComboBox x:Name="cmbBalancedPlan" Grid.Column="1" Width="240" MinWidth="180" Style="{StaticResource SettingsComboBox}"/&gt;
                  &lt;/Grid&gt;
                &lt;/Border&gt;

                &lt;Border Style="{StaticResource SettingsItemRow}" BorderThickness="0"&gt;
                  &lt;Grid&gt;
                    &lt;Grid.ColumnDefinitions&gt;
                      &lt;ColumnDefinition Width="*"/&gt;
                      &lt;ColumnDefinition Width="Auto"/&gt;
                    &lt;/Grid.ColumnDefinitions&gt;
                    &lt;StackPanel Grid.Column="0"&gt;
                      &lt;TextBlock Text="节能" Style="{StaticResource SettingsItemTitle}"/&gt;
                      &lt;TextBlock Text="深度空闲或低电量时使用的电源计划" Style="{StaticResource SettingsItemHint}"/&gt;
                    &lt;/StackPanel&gt;
                    &lt;ComboBox x:Name="cmbPowerSaverPlan" Grid.Column="1" Width="240" MinWidth="180" Style="{StaticResource SettingsComboBox}"/&gt;
                  &lt;/Grid&gt;
                &lt;/Border&gt;

                &lt;TextBlock x:Name="lblPlanMappingStatus" Text="" Style="{StaticResource SettingsItemHint}" Margin="0,8,0,0"/&gt;
              &lt;/StackPanel&gt;
            &lt;/Border&gt;
          &lt;/StackPanel&gt;

          &lt;!-- Notifications Page --&gt;
          &lt;StackPanel x:Name="pageNotifications" Visibility="Collapsed" HorizontalAlignment="Stretch"&gt;

            &lt;Border Style="{StaticResource SettingsCard}"&gt;
              &lt;StackPanel&gt;
                &lt;TextBlock Text="通知与守护" Style="{StaticResource SettingsGroupTitle}"/&gt;
                &lt;TextBlock Text="控制通知行为和守护模式" Style="{StaticResource SettingsCardDescription}"/&gt;

                &lt;Border Style="{StaticResource SettingsItemRow}"&gt;
                  &lt;Grid&gt;
                    &lt;Grid.ColumnDefinitions&gt;
                      &lt;ColumnDefinition Width="*"/&gt;
                      &lt;ColumnDefinition Width="Auto"/&gt;
                    &lt;/Grid.ColumnDefinitions&gt;
                    &lt;StackPanel Grid.Column="0"&gt;
                      &lt;TextBlock Text="暂停守护" Style="{StaticResource SettingsItemTitle}"/&gt;
                      &lt;TextBlock Text="仅监控状态，不自动切换电源计划" Style="{StaticResource SettingsItemHint}"/&gt;
                    &lt;/StackPanel&gt;
                    &lt;CheckBox x:Name="tglPaused" Grid.Column="1" Style="{StaticResource ToggleSwitch}"/&gt;
                  &lt;/Grid&gt;
                &lt;/Border&gt;

                &lt;Border Style="{StaticResource SettingsItemRow}"&gt;
                  &lt;Grid&gt;
                    &lt;Grid.ColumnDefinitions&gt;
                      &lt;ColumnDefinition Width="*"/&gt;
                      &lt;ColumnDefinition Width="Auto"/&gt;
                    &lt;/Grid.ColumnDefinitions&gt;
                    &lt;StackPanel Grid.Column="0"&gt;
                      &lt;TextBlock Text="自动切换通知" Style="{StaticResource SettingsItemTitle}"/&gt;
                      &lt;TextBlock Text="SmartGuard 切换电源计划时弹出系统通知" Style="{StaticResource SettingsItemHint}"/&gt;
                    &lt;/StackPanel&gt;
                    &lt;CheckBox x:Name="tglNotify" Grid.Column="1" Style="{StaticResource ToggleSwitch}"/&gt;
                  &lt;/Grid&gt;
                &lt;/Border&gt;

                &lt;Border Style="{StaticResource SettingsItemRow}" BorderThickness="0"&gt;
                  &lt;Grid&gt;
                    &lt;Grid.ColumnDefinitions&gt;
                      &lt;ColumnDefinition Width="*"/&gt;
                      &lt;ColumnDefinition Width="Auto"/&gt;
                    &lt;/Grid.ColumnDefinitions&gt;
                    &lt;StackPanel Grid.Column="0"&gt;
                      &lt;TextBlock Text="外部变更通知" Style="{StaticResource SettingsItemTitle}"/&gt;
                      &lt;TextBlock Text="检测到计划被外部修改时弹出系统通知" Style="{StaticResource SettingsItemHint}"/&gt;
                    &lt;/StackPanel&gt;
                    &lt;CheckBox x:Name="tglNotifyExternal" Grid.Column="1" Style="{StaticResource ToggleSwitch}"/&gt;
                  &lt;/Grid&gt;
                &lt;/Border&gt;
              &lt;/StackPanel&gt;
            &lt;/Border&gt;
          &lt;/StackPanel&gt;

          &lt;!-- Display Page --&gt;
          &lt;StackPanel x:Name="pageDisplay" Visibility="Collapsed" HorizontalAlignment="Stretch"&gt;

            &lt;Border Style="{StaticResource SettingsCard}"&gt;
              &lt;StackPanel&gt;
                &lt;TextBlock Text="外观" Style="{StaticResource SettingsGroupTitle}"/&gt;
                &lt;TextBlock Text="选择界面配色方案" Style="{StaticResource SettingsCardDescription}"/&gt;

                &lt;Border x:Name="rowThemeFollowSystem" Style="{StaticResource SettingsItemRow}" BorderThickness="0"&gt;
                  &lt;Grid&gt;
                    &lt;Grid.ColumnDefinitions&gt;
                      &lt;ColumnDefinition Width="*"/&gt;
                      &lt;ColumnDefinition Width="Auto"/&gt;
                    &lt;/Grid.ColumnDefinitions&gt;
                    &lt;StackPanel Grid.Column="0"&gt;
                      &lt;TextBlock Text="跟随系统" Style="{StaticResource SettingsItemTitle}"/&gt;
                      &lt;TextBlock Text="自动匹配 Windows 浅色或深色模式" Style="{StaticResource SettingsItemHint}"/&gt;
                    &lt;/StackPanel&gt;
                    &lt;CheckBox x:Name="tglThemeFollowSystem" Grid.Column="1" Style="{StaticResource ToggleSwitch}"/&gt;
                  &lt;/Grid&gt;
                &lt;/Border&gt;

                &lt;Border x:Name="rowThemeLight" Style="{StaticResource SettingsItemRow}" Visibility="Collapsed"&gt;
                  &lt;Grid&gt;
                    &lt;Grid.ColumnDefinitions&gt;
                      &lt;ColumnDefinition Width="*"/&gt;
                      &lt;ColumnDefinition Width="Auto"/&gt;
                    &lt;/Grid.ColumnDefinitions&gt;
                    &lt;StackPanel Grid.Column="0"&gt;
                      &lt;TextBlock Text="浅色模式" Style="{StaticResource SettingsItemTitle}"/&gt;
                      &lt;TextBlock Text="使用浅色界面配色" Style="{StaticResource SettingsItemHint}"/&gt;
                    &lt;/StackPanel&gt;
                    &lt;CheckBox x:Name="tglThemeLight" Grid.Column="1" Style="{StaticResource ToggleSwitch}"/&gt;
                  &lt;/Grid&gt;
                &lt;/Border&gt;

                &lt;Border x:Name="rowThemeDark" Style="{StaticResource SettingsItemRow}" BorderThickness="0" Visibility="Collapsed"&gt;
                  &lt;Grid&gt;
                    &lt;Grid.ColumnDefinitions&gt;
                      &lt;ColumnDefinition Width="*"/&gt;
                      &lt;ColumnDefinition Width="Auto"/&gt;
                    &lt;/Grid.ColumnDefinitions&gt;
                    &lt;StackPanel Grid.Column="0"&gt;
                      &lt;TextBlock Text="深色模式" Style="{StaticResource SettingsItemTitle}"/&gt;
                      &lt;TextBlock Text="使用深色界面配色" Style="{StaticResource SettingsItemHint}"/&gt;
                    &lt;/StackPanel&gt;
                    &lt;CheckBox x:Name="tglThemeDark" Grid.Column="1" Style="{StaticResource ToggleSwitch}"/&gt;
                  &lt;/Grid&gt;
                &lt;/Border&gt;
              &lt;/StackPanel&gt;
            &lt;/Border&gt;
          &lt;/StackPanel&gt;

          &lt;!-- About Page --&gt;
          &lt;StackPanel x:Name="pageAbout" Visibility="Collapsed" HorizontalAlignment="Stretch"&gt;

            &lt;Border Style="{StaticResource SettingsCard}"&gt;
              &lt;StackPanel&gt;
                &lt;TextBlock Text="SmartGuard" Style="{StaticResource SettingsGroupTitle}"/&gt;
                &lt;TextBlock Text="智能电源守护" Style="{StaticResource SettingsCardDescription}"/&gt;

                &lt;Border Style="{StaticResource SettingsItemRow}"&gt;
                  &lt;Grid&gt;
                    &lt;Grid.ColumnDefinitions&gt;
                      &lt;ColumnDefinition Width="*"/&gt;
                      &lt;ColumnDefinition Width="Auto"/&gt;
                    &lt;/Grid.ColumnDefinitions&gt;
                    &lt;StackPanel Grid.Column="0"&gt;
                      &lt;TextBlock Text="版本" Style="{StaticResource SettingsItemTitle}"/&gt;
                      &lt;TextBlock x:Name="txtVersion" Text="1.0.0" Style="{StaticResource SettingsItemHint}"/&gt;
                    &lt;/StackPanel&gt;
                  &lt;/Grid&gt;
                &lt;/Border&gt;

                &lt;Border Style="{StaticResource SettingsItemRow}"&gt;
                  &lt;Grid&gt;
                    &lt;Grid.ColumnDefinitions&gt;
                      &lt;ColumnDefinition Width="*"/&gt;
                      &lt;ColumnDefinition Width="Auto"/&gt;
                    &lt;/Grid.ColumnDefinitions&gt;
                    &lt;StackPanel Grid.Column="0"&gt;
                      &lt;TextBlock Text="仓库地址" Style="{StaticResource SettingsItemTitle}"/&gt;
                      &lt;TextBlock Style="{StaticResource SettingsItemHint}"&gt;
                        &lt;Hyperlink x:Name="lnkRepo" NavigateUri="https://github.com/rainiva/SmartGuard"&gt;
                          https://github.com/rainiva/SmartGuard
                        &lt;/Hyperlink&gt;
                      &lt;/TextBlock&gt;
                    &lt;/StackPanel&gt;
                  &lt;/Grid&gt;
                &lt;/Border&gt;

                &lt;Border Style="{StaticResource SettingsItemRow}"&gt;
                  &lt;Grid&gt;
                    &lt;Grid.ColumnDefinitions&gt;
                      &lt;ColumnDefinition Width="*"/&gt;
                      &lt;ColumnDefinition Width="Auto"/&gt;
                    &lt;/Grid.ColumnDefinitions&gt;
                    &lt;StackPanel Grid.Column="0"&gt;
                      &lt;TextBlock Text="更新" Style="{StaticResource SettingsItemTitle}"/&gt;
                      &lt;TextBlock Text="检查是否有新版本可用" Style="{StaticResource SettingsItemHint}"/&gt;
                    &lt;/StackPanel&gt;
                    &lt;Button x:Name="btnCheckUpdate" Grid.Column="1" Content="检查更新" Style="{StaticResource PrimaryButton}"/&gt;
                  &lt;/Grid&gt;
                &lt;/Border&gt;

                &lt;Border Style="{StaticResource SettingsItemRow}" BorderThickness="0"&gt;
                  &lt;StackPanel&gt;
                    &lt;TextBlock Text="GitHub Token" Style="{StaticResource SettingsItemTitle}"/&gt;
                    &lt;TextBlock x:Name="txtGitHubTokenStatus" Text="未配置" Style="{StaticResource SettingsItemHint}"/&gt;
                    &lt;TextBlock Text="公开仓库通常无需配置；若检查更新频繁触发限流，可填写 GitHub 个人访问令牌（建议最小权限 public_repo）。" Style="{StaticResource SettingsItemHint}" TextWrapping="Wrap" Margin="0,4,0,8"/&gt;
                    &lt;PasswordBox x:Name="pwdGitHubToken" Margin="0,0,0,8" Padding="10,8" FontSize="13"/&gt;
                    &lt;StackPanel Orientation="Horizontal"&gt;
                      &lt;Button x:Name="btnSaveGitHubToken" Content="保存 Token" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/&gt;
                      &lt;Button x:Name="btnClearGitHubToken" Content="清除 Token" Style="{StaticResource SecondaryButton}"/&gt;
                    &lt;/StackPanel&gt;
                  &lt;/StackPanel&gt;
                &lt;/Border&gt;
              &lt;/StackPanel&gt;
            &lt;/Border&gt;

            &lt;Border Style="{StaticResource SettingsCard}"&gt;
              &lt;StackPanel&gt;
                &lt;TextBlock Text="维护" Style="{StaticResource SettingsGroupTitle}"/&gt;
                &lt;TextBlock Text="配置异常时可恢复默认策略" Style="{StaticResource SettingsCardDescription}"/&gt;

                &lt;Border Style="{StaticResource SettingsItemRow}"&gt;
                  &lt;Grid&gt;
                    &lt;Grid.ColumnDefinitions&gt;
                      &lt;ColumnDefinition Width="*"/&gt;
                      &lt;ColumnDefinition Width="Auto"/&gt;
                    &lt;/Grid.ColumnDefinitions&gt;
                    &lt;StackPanel Grid.Column="0"&gt;
                      &lt;TextBlock Text="导出诊断包" Style="{StaticResource SettingsItemTitle}"/&gt;
                      &lt;TextBlock Text="打包配置、状态与日志（已剔除 Token），便于反馈问题" Style="{StaticResource SettingsItemHint}" TextWrapping="Wrap"/&gt;
                    &lt;/StackPanel&gt;
                    &lt;Button x:Name="btnExportDiagnostic" Grid.Column="1" Content="导出诊断包…" Style="{StaticResource SecondaryButton}"/&gt;
                  &lt;/Grid&gt;
                &lt;/Border&gt;

                &lt;Border Style="{StaticResource SettingsItemRow}" BorderThickness="0"&gt;
                  &lt;Grid&gt;
                    &lt;Grid.ColumnDefinitions&gt;
                      &lt;ColumnDefinition Width="*"/&gt;
                      &lt;ColumnDefinition Width="Auto"/&gt;
                    &lt;/Grid.ColumnDefinitions&gt;
                    &lt;StackPanel Grid.Column="0"&gt;
                      &lt;TextBlock Text="恢复默认策略" Style="{StaticResource SettingsItemTitle}"/&gt;
                      &lt;TextBlock Text="重置阈值与计划映射；保留日志路径和 GitHub Token" Style="{StaticResource SettingsItemHint}" TextWrapping="Wrap"/&gt;
                    &lt;/StackPanel&gt;
                    &lt;Button x:Name="btnResetDefaults" Grid.Column="1" Content="恢复默认" Style="{StaticResource SecondaryButton}"/&gt;
                  &lt;/Grid&gt;
                &lt;/Border&gt;
              &lt;/StackPanel&gt;
            &lt;/Border&gt;
          &lt;/StackPanel&gt;


        &lt;/StackPanel&gt;
      &lt;/ScrollViewer&gt;

      &lt;!-- Logs Page --&gt;
      &lt;!-- Kept outside contentScrollViewer so the log area is the only scrollable region on this page. --&gt;
      &lt;Grid x:Name="pageLogs" Grid.Row="1" Visibility="Collapsed" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"&gt;
        &lt;Border Style="{StaticResource SettingsCard}" VerticalAlignment="Stretch"&gt;
          &lt;Grid VerticalAlignment="Stretch"&gt;
            &lt;Grid.RowDefinitions&gt;
              &lt;RowDefinition Height="Auto"/&gt;
              &lt;RowDefinition Height="*"/&gt;
              &lt;RowDefinition Height="Auto"/&gt;
            &lt;/Grid.RowDefinitions&gt;

            &lt;!-- Fixed Header: Search, filters, and summary --&gt;
            &lt;StackPanel Grid.Row="0"&gt;
              &lt;TextBlock Text="&amp;#x67E5;&amp;#x770B; SmartGuard &amp;#x8FD0;&amp;#x884C;&amp;#x65E5;&amp;#x5FD7;&amp;#xFF0C;&amp;#x652F;&amp;#x6301;&amp;#x641C;&amp;#x7D22;&amp;#x548C;&amp;#x7B5B;&amp;#x9009;" Style="{StaticResource SettingsCardDescription}"/&gt;

              &lt;Grid Margin="0,0,0,12"&gt;
                &lt;Grid.ColumnDefinitions&gt;
                  &lt;ColumnDefinition Width="*"/&gt;
                  &lt;ColumnDefinition Width="Auto"/&gt;
                &lt;/Grid.ColumnDefinitions&gt;

                &lt;Border Grid.Column="0" Background="{DynamicResource NumberBoxBackground}" BorderBrush="{DynamicResource NumberBoxBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,6"&gt;
                  &lt;Grid&gt;
                    &lt;Grid.ColumnDefinitions&gt;
                      &lt;ColumnDefinition Width="Auto"/&gt;
                      &lt;ColumnDefinition Width="*"/&gt;
                    &lt;/Grid.ColumnDefinitions&gt;
                    &lt;TextBlock Text="&amp;#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource TextTertiary}" Margin="0,0,8,0" VerticalAlignment="Center"/&gt;
                    &lt;ContentControl x:Name="logSearchFilterHost" Grid.Column="1" VerticalAlignment="Center"/&gt;
                  &lt;/Grid&gt;
                &lt;/Border&gt;

                &lt;Grid Grid.Column="1" Margin="12,0,0,0" HorizontalAlignment="Right"
                      Panel.ZIndex="10"&gt;
                  &lt;StackPanel Orientation="Horizontal" HorizontalAlignment="Right"&gt;
                    &lt;Button x:Name="btnLogRefresh" Content="&amp;#x5237;&amp;#x65B0;" Style="{StaticResource LogToolbarCompactButton}" Margin="0,0,8,0"/&gt;
                    &lt;Button x:Name="btnLogMore" Content="&amp;#x66F4;&amp;#x591A;" Style="{StaticResource LogToolbarCompactButton}"/&gt;
                  &lt;/StackPanel&gt;
                &lt;/Grid&gt;
              &lt;/Grid&gt;

              &lt;WrapPanel x:Name="logFilterLevelPanel" Margin="0,0,0,8"&gt;
                &lt;TextBlock Text="&amp;#x6807;&amp;#x7B7E;" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,6"/&gt;
                &lt;WrapPanel x:Name="logTagFilterLinksPanel"/&gt;
              &lt;/WrapPanel&gt;

              &lt;WrapPanel x:Name="logFilterTimePanel" Margin="0,0,0,4"&gt;
                &lt;TextBlock Text="&amp;#x65F6;&amp;#x95F4;" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,6"/&gt;
