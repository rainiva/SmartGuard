                &lt;/StackPanel&gt;
              &lt;/Border&gt;
            &lt;/Canvas&gt;
          &lt;/Grid&gt;
        &lt;/Border&gt;
      &lt;/Grid&gt;

      &lt;!-- Settings are applied instantly; no bottom action bar is needed. --&gt;
    &lt;/Grid&gt;

    &lt;!-- Inline toast overlay --&gt;
    &lt;Border x:Name="toastContainer"
